# VeriPay Environment Variables

# PayPal Developer Sandbox Credentials
# Get these from: https://developer.paypal.com/dashboard/applications/sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=sb-test-client-id
PAYPAL_CLIENT_SECRET=sb-test-client-secret
PAYPAL_ENVIRONMENT=sandbox

# Optional: Google Gemini or OpenAI API Key for live AI Agent Verification
# If not provided, VeriPay uses its internal deterministic AST & criteria evaluation engine.
GEMINI_API_KEY=
OPENAI_API_KEY=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
