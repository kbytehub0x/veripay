# VeriPay Environment Variables

# PayPal Developer Sandbox Credentials
# Get these from: https://developer.paypal.com/dashboard/applications/sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=sb-test-client-id
PAYPAL_CLIENT_SECRET=sb-test-client-secret
PAYPAL_ENVIRONMENT=sandbox

# Optional but HIGHLY RECOMMENDED for judges:
# Enables live Google Gemini 1.5 Flash AI evaluation & semantic diff reasoning.
# Free instant API key available at: https://aistudio.google.com/app/apikey
# If omitted, VeriPay automatically falls back to its deterministic AST & test parser engine.
GEMINI_API_KEY=
OPENAI_API_KEY=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
